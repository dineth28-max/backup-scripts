# ---- Schedule ----------------------------------------------------------------
# Cron time, 5 fields, in the SERVER's timezone (check: timedatectl).
#   server on Asia/Colombo -> "0 2 * * *"   = 02:00 Sri Lanka
#   server on UTC          -> "30 20 * * *" = 02:00 Sri Lanka
#                             ("0 2 * * *" on UTC would run at 07:30 Sri Lanka!)
# Re-run scripts/install_cron.sh after changing this — it prints the
# resulting Sri Lanka time so you can confirm.
BACKUP_CRON_SCHEDULE="0 2 * * *"


# ---- Export ------------------------------------------------------------------
# Max time a single database export may run before it's killed and marked failed.
EXPORT_TIMEOUT=6h
# Skip an export (and report it as failed) if the staging disk has less than
# this many GB free — the same disk holds the live SQL Server data.
MIN_FREE_GB=20


# ---- Local paths -------------------------------------------------------------
# Staging only — each .bacpac is deleted right after it uploads.
BACKUP_TMP_DIR=/opt/antlerfoundry/backup_tmp
LOG_DIR=/opt/antlerfoundry/Backupscripting/logs
LOCK_FILE=/tmp/mssql_backup.lock
# Daily log files older than this are deleted.
LOG_RETENTION_DAYS=30


# ---- Retention ---------------------------------------------------------------
# Keeps the last 3 days per SQL Server; the 4th day's run deletes the oldest.
# A server whose backup failed is never pruned.
DAILY_RETENTION_DAYS=3

# ALERT_EMAIL=
