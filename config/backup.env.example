# =============================================================================
# Backup config for THIS server. This is the only file you edit — the scripts
# are identical on every server.
# =============================================================================

# ---- Google Cloud Storage --------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=db_backups_antler
# Folder for this server inside the bucket. Each SQL Server gets its own
# sub-folder under it, named after MSSQL_<n>_CONTAINER:
#   gs://<GCS_BUCKET>/<GCS_PREFIX>/<container>/<YYYY-MM-DD_HHMMSS>/<db>_<stamp>.bacpac
GCS_PREFIX=ovh-vps-4a559a55
GOOGLE_APPLICATION_CREDENTIALS=/opt/antlerfoundry/secrets/gcs_service_account.json


# ---- SQL Servers to back up --------------------------------------------------
# One numbered block per SQL Server. The script backs up every block it finds,
# in number order, one after another (a queue): 2 blocks = 2 servers backed
# up, 6 blocks = 6, and so on. To add a server, add the next number; to skip
# one, comment out its whole block.
#
#   MSSQL_<n>_CONTAINER      docker container name — also the GCS folder name
#   MSSQL_<n>_HOST           where SQL Server listens (localhost on this host)
#   MSSQL_<n>_PORT           the host port mapped to the container's 1433
#   MSSQL_<n>_USER           SQL login (sa)
#   (values must not contain spaces — or wrap the value in "quotes")
#   MSSQL_<n>_PASSWORD_FILE  path to a file containing ONLY the password —
#                            never the password itself
#   MSSQL_<n>_DATABASE       database to back up; several: DbA,DbB (no spaces)
#                            * = every online user database in that server

# --- SQL Server 1 ---
MSSQL_1_CONTAINER=ms-sql-server-dev-antlerhrmdfc
MSSQL_1_HOST=localhost
MSSQL_1_PORT=13727
MSSQL_1_USER=sa
MSSQL_1_PASSWORD_FILE=/opt/antlerfoundry/secrets/mssql_password
MSSQL_1_DATABASE=antler

# --- SQL Server 2 ---
MSSQL_2_CONTAINER=ms-sql-server-dev-antlerhrm
