# ---- Google Cloud Storage --------
GCP_PROJECT_ID=antler-foundry
GCS_BUCKET=db_backups_antler

GCS_PREFIX=ovh-vps-4a559a55
GOOGLE_APPLICATION_CREDENTIALS=/opt/antlerfoundry/secrets/antler.json

# --- SQL Server 1 ---
MSSQL_1_CONTAINER=sqlserver1
MSSQL_1_HOST=localhost
MSSQL_1_PORT=1433
MSSQL_1_USER=sa
MSSQL_1_PASSWORD_FILE=/opt/antlerfoundry/secrets/mssql_password1
MSSQL_1_DATABASE=antler

# --- SQL Server 2 ---
MSSQL_2_CONTAINER=ms-sql-server-dev-antlerhrmdfc
MSSQL_2_HOST=localhost
MSSQL_2_PORT=14367
MSSQL_2_USER=sa
MSSQL_2_PASSWORD_FILE=/opt/antlerfoundry/secrets/mssql_password
MSSQL_2_DATABASE=antler

# --- SQL Server 3 ---
MSSQL_3_CONTAINER=sqlserver2
MSSQL_3_HOST=localhost
MSSQL_3_PORT=1434
MSSQL_3_USER=sa
MSSQL_3_PASSWORD_FILE=/opt/antlerfoundry/secrets/mssql/mssql_password2
MSSQL_3_DATABASE=antler



# --- SQL Server 4 ---
MSSQL_4_CONTAINER=sqlserver3
MSSQL_4_HOST=localhost
MSSQL_4_PORT=1435
MSSQL_4_USER=sa
MSSQL_4_PASSWORD_FILE=/opt/antlerfoundry/secrets/mssql/mssql_password3
MSSQL_4_DATABASE=antler

# --- SQL Server 5 ---
MSSQL_5_CONTAINER=sqlserver4
MSSQL_5_HOST=localhost
MSSQL_5_PORT=1436
MSSQL_5_USER=sa
MSSQL_5_PASSWORD_FILE=/opt/antlerfoundry/secrets/mssql/mssql_password4
MSSQL_5_DATABASE=antler


# --- Backup Settings -------
BACKUP_CRON_SCHEDULE="0 2 * * *"

EXPORT_TIMEOUT=6h

MIN_FREE_GB=20

BACKUP_TMP_DIR=/opt/antlerfoundry/backup_tmp
LOG_DIR=/opt/antlerfoundry/Backupscripting/logs
LOCK_FILE=/tmp/mssql_backup.lock

LOG_RETENTION_DAYS=30
DAILY_RETENTION_DAYS=3

